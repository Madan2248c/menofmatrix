/* ============================================================
   Design System - editorial / Airtable-style
   White canvas / ink type / near-black CTAs / signature surfaces
   ============================================================ */
:root {
  --primary: #181d26;
  --primary-active: #0d1218;
  --on-primary: #ffffff;
  --canvas: #ffffff;
  --surface-soft: #f8fafc;
  --surface-strong: #e0e2e6;
  --surface-dark: #181d26;
  --hairline: #dddddd;
  --ink: #181d26;
  --body-c: #333840;
  --muted: #41454d;
  --sig-coral: #aa2d00;
  --sig-forest: #0a2e0e;
  --sig-cream: #f5e9d4;
  --sig-peach: #fcab79;
  --sig-mint: #a8d8c4;
  --sig-yellow: #f4d35e;
  --link: #1b61c9;
  --success: #006400;
  --info-border: #458fff;
  --r-sm: 6px;
  --r-md: 10px;
  --r-lg: 12px;
  --s-md: 16px;
  --s-lg: 24px;
  --s-xl: 32px;
  --s-xxl: 48px;
  --section: 96px;
  --font: 'Inter Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
    Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: var(--font);
  background: var(--canvas);
  color: var(--body-c);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.25;
}

h1, h2 { color: var(--ink); font-weight: 400; }
h1 { font-size: 40px; line-height: 1.2; }
h2 { font-size: 32px; line-height: 1.2; }
h3 { color: var(--ink); font-size: 20px; font-weight: 400; line-height: 1.5; }

.app { min-height: 100vh; display: flex; flex-direction: column; }
.main { max-width: 1280px; width: 100%; margin: 0 auto; padding: var(--s-lg) 48px var(--s-xxl); flex: 1; }

/* Top nav: flat white bar */
.nav {
  display: flex; justify-content: space-between; align-items: center;
  min-height: 64px; padding: 0 48px; background: var(--canvas);
  border-bottom: 1px solid var(--hairline);
}
.brand { font-weight: 500; font-size: 16px; text-decoration: none; color: var(--ink); }
.nav nav { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; padding: 8px 0; }
.nav a { text-decoration: none; color: var(--muted); font-size: 14px; }
.nav a.active { color: var(--ink); font-weight: 500; }
.link {
  background: none; border: none; color: var(--muted);
  cursor: pointer; font-size: 14px; font-family: inherit;
}
.account-switch {
  padding: 8px 12px; border-radius: var(--r-sm); border: 1px solid var(--hairline);
  background: var(--canvas); font-size: 14px; max-width: 170px;
  color: var(--ink); font-family: inherit;
}

/* Buttons */
.btn {
  display: inline-block; background: var(--primary); color: var(--on-primary) !important;
  border: none; border-radius: var(--r-lg);
  padding: 16px 24px; font-size: 16px; font-weight: 500; line-height: 1.4;
  cursor: pointer; text-decoration: none; font-family: inherit; min-height: 48px;
}
.btn:active { background: var(--primary-active); }
.btn:disabled { opacity: 0.5; }
.btn.ghost {
  background: var(--canvas); color: var(--ink) !important;
  border: 1px solid var(--hairline);
}

/* Hero: pure whitespace */
.hero { padding: var(--section) 0 var(--s-xl); max-width: 720px; }
.hero p {
  color: var(--body-c); margin: var(--s-md) 0 var(--s-xl);
  font-size: 16px; line-height: 1.5; max-width: 520px;
}

.card {
  background: var(--canvas); border: 1px solid var(--hairline);
  border-radius: var(--r-md); padding: var(--s-xl); margin: var(--s-lg) 0;
}

/* Signature bands */
.signature {
  border-radius: var(--r-lg); padding: var(--s-xxl); margin: 96px 0;
  color: var(--on-primary);
}
.signature.coral { background: var(--sig-coral); }
.signature.dark { background: var(--surface-dark); }
.signature.cream { background: var(--sig-cream); color: var(--ink); border-radius: var(--r-md); padding: var(--s-lg); }
.signature.coral h2, .signature.dark h2 { color: var(--on-primary); }
.signature p { font-size: 14px; line-height: 1.5; margin: var(--s-md) 0 var(--s-lg); max-width: 480px; opacity: 0.92; }

/* Demo grid (feature trio) */
.demo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-lg); margin: 96px 0; }
.demo-card { border-radius: var(--r-md); padding: var(--s-lg); min-height: 180px; }
.demo-card.mint { background: var(--sig-mint); }
.demo-card.peach { background: var(--sig-peach); }
.demo-card.yellow { background: var(--sig-yellow); }
.demo-card h3 { font-size: 16px; font-weight: 500; margin-bottom: 8px; }
.demo-card p { font-size: 14px; line-height: 1.45; color: var(--body-c); }
.demo-card:nth-child(2) { min-height: 220px; }

.login-card { max-width: 380px; margin: 96px auto; }
.login-card input {
  width: 100%; height: 44px; padding: 12px 16px; margin: 8px 0 16px;
  border: 1px solid var(--hairline); border-radius: var(--r-sm);
  font-size: 14px; color: var(--ink); font-family: inherit;
}
.login-card input:focus { outline: none; border-color: var(--info-border); }
.login-card button { width: 100%; }

.toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-lg); flex-wrap: wrap; gap: 8px; }
.filters { display: flex; gap: 8px; }
.chip {
  padding: 8px 16px; border-radius: var(--r-sm); border: 1px solid var(--hairline);
  background: var(--canvas); cursor: pointer; font-size: 14px;
  color: var(--body-c); font-family: inherit;
}
.chip.active { background: var(--primary); color: var(--on-primary); border-color: var(--primary); }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--s-lg); }
.tile {
  background: var(--canvas); border: 1px solid var(--hairline);
  border-radius: var(--r-md); overflow: hidden; text-decoration: none; color: inherit;
}
.thumb { position: relative; aspect-ratio: 1; background: var(--surface-strong); display: flex; align-items: center; justify-content: center; }
.thumb img, .thumb video { width: 100%; height: 100%; object-fit: cover; display: block; }
.thumb span { color: var(--muted); }
.badge {
  position: absolute; top: 8px; left: 8px; background: var(--surface-dark); color: var(--on-primary);
  font-size: 11px; font-weight: 500; padding: 3px 8px; border-radius: 9999px; text-transform: uppercase;
}
.meta { padding: var(--s-md); }
.caption { font-size: 13px; min-height: 32px; }
.stats { font-size: 13px; margin-top: 6px; color: var(--body-c); }
.date { font-size: 12px; color: var(--muted); margin-top: 4px; }

.detail { display: grid; grid-template-columns: minmax(280px, 480px) 1fr; gap: var(--s-xl); margin-top: var(--s-lg); }
.detail .media img, .detail .media video { width: 100%; border-radius: var(--r-md); }
.info h2 { margin: 4px 0; font-size: 20px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.12px; }
.metric-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: var(--s-md); margin-top: var(--s-lg); }
.metric-grid.wide { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
.metric {
  background: var(--sig-cream); border-radius: var(--r-md); padding: var(--s-lg); margin: 0;
}
.metric strong { font-size: 22px; display: block; font-weight: 500; color: var(--ink); }
.metric span { color: var(--muted); font-size: 13px; }

.stories-row { display: flex; gap: var(--s-lg); flex-wrap: wrap; }
.story { width: 180px; }
.story img, .story video { width: 180px; height: 320px; object-fit: cover; border-radius: var(--r-md); background: var(--surface-strong); }

.table { width: 100%; border-collapse: collapse; }
.table th, .table td { padding: 12px 0; text-align: left; border-bottom: 1px solid var(--hairline); }
.toplist { list-style: none; }
.toplist li { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--hairline); gap: 16px; }
.toplist a { color: var(--ink); text-decoration: none; }
.account-list { list-style: none; margin: 8px 0; }
.account-list li { padding: 6px 0; }

.error { color: var(--sig-coral); margin: var(--s-md) 0; }
.ok { color: var(--success); }
.notice {
  background: var(--surface-soft); border: 1px solid var(--info-border);
  padding: var(--s-md); border-radius: var(--r-sm); margin: var(--s-md) 0; color: var(--ink);
}
.note { color: var(--muted); font-size: 13px; margin: 8px 0 var(--s-lg); }

@media (max-width: 1024px) { .demo-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) {
  .main { padding: var(--s-md) 16px var(--s-xl); }
  .nav { padding: 0 16px; }
  .hero { padding: var(--s-xl) 0 var(--s-lg); }
  .hero h1 { font-size: 32px; }
  .demo-grid { grid-template-columns: 1fr; margin: var(--s-xl) 0; }
  .signature { padding: var(--s-xl); margin: var(--s-xl) 0; }
  .detail { grid-template-columns: 1fr; }
}

/* Brand */
.brand { display: flex; align-items: center; gap: 10px; }
.nav-logo { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }

/* Newsletter */
.newsletter { display: flex; gap: 12px; max-width: 460px; flex-wrap: wrap; }
.newsletter input {
  flex: 1; min-width: 220px; height: 48px; padding: 12px 16px;
  border: 1px solid var(--hairline); border-radius: var(--r-sm);
  font-size: 14px; color: var(--ink); font-family: inherit;
}
.newsletter input:focus { outline: none; border-color: var(--info-border); }

/* Feed */
.feed { margin: 96px 0; }

/* Dark signature band with logo */
.dark-band-inner { display: flex; gap: var(--s-xl); align-items: center; }
.band-logo { width: 96px; height: 96px; border-radius: var(--r-lg); object-fit: cover; flex-shrink: 0; }

/* Footer */
.footer {
  display: flex; justify-content: space-between; align-items: center;
  padding: var(--s-lg) 48px; border-top: 1px solid var(--hairline);
  color: var(--muted); font-size: 14px; flex-wrap: wrap; gap: 8px;
}

@media (max-width: 768px) {
  .footer { padding: var(--s-lg) 16px; flex-direction: column; align-items: flex-start; }
  .dark-band-inner { flex-direction: column; align-items: flex-start; }
}

/* Newsletter composer */
.compose { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
.compose input, .compose textarea {
  width: 100%; padding: 12px 16px;
  border: 1px solid var(--hairline); border-radius: var(--r-sm);
  font-size: 14px; color: var(--ink); font-family: inherit;
}
.compose input:focus, .compose textarea:focus { outline: none; border-color: var(--info-border); }
.compose button { align-self: flex-start; }

/* Live news feed */
.news-list { display: flex; flex-direction: column; max-width: 860px; }
.news-item {
  display: block; padding: 20px 0; border-bottom: 1px solid var(--hairline);
  text-decoration: none; color: inherit;
}
.news-meta { display: flex; gap: 12px; align-items: center; margin-bottom: 6px; }
.news-source {
  background: var(--sig-cream); color: var(--ink); font-size: 11px; font-weight: 500;
  padding: 2px 10px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.16px;
}
.news-title { font-size: 18px; font-weight: 500; color: var(--ink); margin-bottom: 6px; }
.news-item:hover .news-title { color: var(--link); }
