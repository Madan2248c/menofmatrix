# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Admin password protecting the dashboard APIs (frontend login)
ADMIN_PASSWORD=change-me

# JWT secret for issuing session tokens
JWT_SECRET=some-long-random-string

# --- Meta / Instagram app credentials ---
# From developers.facebook.com -> your app -> API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:4000/api/auth/callback
IG_GRAPH_VERSION=v23.0

# --- Neon Postgres ---
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
