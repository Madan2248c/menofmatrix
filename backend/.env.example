# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Admin password protecting the dashboard APIs (frontend login)
ADMIN_PASSWORD=change-me

# JWT secret for issuing session tokens
JWT_SECRET=some-long-random-string

# Secret that protects /api/cron/* endpoints (external schedulers must send it
# as `x-cron-secret` header or `Authorization: Bearer <value>`)
CRON_SECRET=another-long-random-string

# --- Meta / Instagram app credentials ---
# From developers.facebook.com -> your app -> API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:4000/api/auth/callback
IG_GRAPH_VERSION=v23.0

# --- Neon Postgres ---
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- S3-compatible object storage (blog image uploads) ---
# The AWS SDK reads AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY from the environment automatically. S3_BUCKET is the
# (private) bucket uploads go into; images are served back via /api/uploads/*.
S3_BUCKET=assets
